  "cards": [
    {
      "dot": "cyan",
      "title": "Public flow",
      "items": [
        "Visitors register or leave feedback without an account",
        "Postgres RLS and triggers decide confirmed vs waitlisted",
        "Ticket page reads via ticket_lookup, a security-definer function"
      ]
    },
    {
      "dot": "emerald",
      "title": "Lead / admin flow",
      "items": [
        "proxy.ts refreshes the session cookie and redirects logged-out users to /login",
        "requireClubAccess 404s clubs the user does not manage",
        "Check-in by ticket code updates registrations under RLS"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "Service-role key is used only after requireAdmin in createLeadAction",
        "RLS protects participant data even from direct API calls",
        "CI runs lint, tsc and vitest on push and PR"
      ]
    }
  ]
