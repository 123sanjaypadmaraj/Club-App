# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY (never prefix with NEXT_PUBLIC_). Used by the admin to create club-lead accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: public site URL (used for link-preview metadata), e.g. https://your-club-hub.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Security (see SECURITY.md) ---
# Cloudflare Turnstile CAPTCHA (free, https://dash.cloudflare.com → Turnstile). Leave both blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Admin accounts must use two-step login. Set to "off" ONLY as an emergency escape hatch.
ADMIN_MFA=
# Sign leads out after this many idle minutes / hours since sign-in (defaults 60 and 12)
SESSION_IDLE_MINUTES=
SESSION_MAX_HOURS=
# Contact for /.well-known/security.txt (mailto: or https:// URL). Leave blank to disable the file.
SECURITY_CONTACT=
# Optional key used to sign the notices shown after actions (so crafted links cannot display fake messages).
# If blank, one is derived from SUPABASE_SERVICE_ROLE_KEY.
FLASH_SECRET=
